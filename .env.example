# Database (SQLite via better-sqlite3)
# Path is relative to project root. The directory is auto-created.
SEMT_DB_PATH=./data/semt.db

# Session security
# Used by future enhancements; cookies are HttpOnly by default.
SEMT_SESSION_SECRET=replace-with-a-long-random-string

# Application URL
SEMT_APP_URL=http://localhost:4000

# Optional: external services (not active in default build)
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# SMS_GATEWAY_URL=
# AI_API_KEY=